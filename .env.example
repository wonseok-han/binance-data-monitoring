# HTTP 서버 포트
PORT=3000

# SQLite 파일 경로 (apps/server 기준 상대경로 가능)
DATABASE_URL=./data/market.db

# Binance 공개 시세 API. API key는 필요 없다.
BINANCE_REST_URL=https://api.binance.com
BINANCE_WS_URL=wss://stream.binance.com:9443

# 수집할 종목. 쉼표로 구분한 대문자 심볼. API의 symbol 허용 목록도 이 값을 그대로 사용한다.
SYMBOLS=BTCUSDT,ETHUSDT

# --- 백필/보존 ---

# 새 DB가 최종적으로 확보할 전체 과거 기간. 단위: 일. 기본 365, 양의 정수.
# RETENTION_DAYS보다 크면 서버가 시작 전 설정 오류로 거부한다.
BACKFILL_DAYS=365
# 서버 시작 시(또는 재연결 직후) 실시간 수집 전환을 막지 않고 우선 채우는 최근 구간.
# 이 구간만 동기로 채운 뒤 실시간 모드로 전환하고, 나머지는 백그라운드로 처리한다.
# 단위: 시간. 기본 24, 양의 정수.
BACKFILL_WARMUP_HOURS=24
# 백그라운드 장기 백필 job이 일시적 오류(네트워크 오류, Binance 429/5xx)를 만났을 때
# 재시도하는 지수 백오프의 시작 지연. job을 failed로 만들지 않고 이 지연부터 2배씩
# 늘려가며 같은 페이지를 재시도한다. 단위: 밀리초. 기본 1000, 양의 정수.
BACKFILL_RETRY_BASE_DELAY_MS=1000
# 위 지수 백오프 지연의 상한. 잘못된 요청 등 재시도로 해결되지 않는 영구 오류만
# 즉시 failed로 확정되며, 그 외에는 이 상한 내에서 무기한 재시도한다.
# 단위: 밀리초. 기본 300000(5분), 양의 정수(BACKFILL_RETRY_BASE_DELAY_MS 이상 권장).
BACKFILL_RETRY_MAX_DELAY_MS=300000
# 1분봉 보존 기간. 이 기간보다 오래된 봉은 정리 작업이 삭제한다. 단위: 일. 기본 365, 양의 정수.
# BACKFILL_DAYS보다 작으면 서버가 시작 전 설정 오류로 거부한다.
RETENTION_DAYS=365
# 만료 데이터 정리 작업의 실행 주기. 단위: 시간. 기본 6, 양의 정수.
RETENTION_CLEANUP_INTERVAL_HOURS=6

# --- 수집기 재시도/재연결 ---

# 이 시간 동안 WebSocket 이벤트가 없으면 상태를 stale로 표시하고 재연결한다. 단위: 초. 기본 10, 양의 정수.
STALE_AFTER_SECONDS=10
# WebSocket 재연결 지수 백오프의 시작 지연. 단위: 밀리초. 기본 1000, 양의 정수.
RECONNECT_BASE_DELAY_MS=1000
# WebSocket 재연결 지수 백오프의 최대 지연 상한. 단위: 밀리초. 기본 30000, 양의 정수(RECONNECT_BASE_DELAY_MS 이상 권장).
RECONNECT_MAX_DELAY_MS=30000
# Binance REST 요청이 재시도 가능한 오류(429/418/5xx)일 때 재시도할 최대 횟수. 기본 3, 0 이상의 정수(0이면 재시도 없음).
BINANCE_REST_MAX_RETRIES=3
# REST 재시도 간 기본 지연(응답에 Retry-After가 없을 때 사용, 시도마다 지수 증가). 단위: 밀리초. 기본 500, 양의 정수.
BINANCE_REST_RETRY_DELAY_MS=500

# --- HTTP ---

# SSE(/api/events) 연결 유지를 위한 heartbeat 주기. 단위: 밀리초. 기본 15000, 양의 정수.
SSE_HEARTBEAT_MS=15000
# 허용할 CORS origin. "*"는 모든 origin 허용(로컬 개발 기본값). 운영에서는 쉼표로 구분한 origin 목록으로 제한한다.
# 예: CORS_ORIGIN=https://dashboard.example.com,https://staging.example.com
CORS_ORIGIN=*

# pino 로그 레벨: fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# apps/web이 REST/SSE를 호출할 API base URL. 비우면 same-origin을 사용하며 로컬 개발에서는 Vite가 API 서버로 프록시한다.
VITE_API_BASE_URL=
