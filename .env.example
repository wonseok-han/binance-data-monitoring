# --- 배포 환경에 따라 달라지는 인프라 설정 ---
# 종목, 백필·보존 기간, 재시도·재연결 정책처럼 배포와 무관한 제품 정책은
# 환경변수가 아니라 apps/server/src/config/policy.ts에서 관리한다.

# HTTP 서버 포트
PORT=3000

# SQLite 파일 경로 (apps/server 기준 상대경로 가능)
DATABASE_URL=./data/market.db

# Binance 공개 시세 API. API key는 필요 없다.
BINANCE_REST_URL=https://api.binance.com
BINANCE_WS_URL=wss://stream.binance.com:9443

# 허용할 CORS origin. "*"는 모든 origin 허용(로컬 개발 기본값). 운영에서는 쉼표로 구분한 origin 목록으로 제한한다.
# 예: CORS_ORIGIN=https://dashboard.example.com,https://staging.example.com
CORS_ORIGIN=*

# pino 로그 레벨: fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# apps/web이 REST/SSE를 호출할 API base URL. 비우면 same-origin을 사용하며 로컬 개발에서는 Vite가 API 서버로 프록시한다.
VITE_API_BASE_URL=
